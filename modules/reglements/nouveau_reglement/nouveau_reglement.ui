   <string notr="true">#Background{background-color:#f8f9fb;}QFrame[class=&quot;card&quot;]{background-color:#fff;border:1px solid #c3c5d8;border-radius:8px;}QFrame[class=&quot;header&quot;]{background-color:#f3f4f6;border:none;border-bottom:1px solid #c3c5d8;border-top-left-radius:8px;border-top-right-radius:8px;}QLabel{color:#191c1e;background:transparent;border:none;font-family:&quot;Inter&quot;,&quot;Tajawal&quot;;font-size:13px;font-weight:500;}QLabel[class=&quot;section-title&quot;]{color:#191c1e;font-size:18px;font-weight:600;}QLabel[class=&quot;field-label&quot;]{color:#434655;font-size:11px;font-weight:600;text-transform:uppercase;}QLineEdit,QTextEdit,QDateEdit,QDoubleSpinBox,QComboBox{background-color:#fff;border:1px solid #c3c5d8;border-radius:4px;padding:6px 12px;color:#191c1e;font-family:&quot;Inter&quot;,&quot;Tajawal&quot;;font-size:13px;font-weight:400;selection-background-color:#0051df;selection-color:#fff;}QTextEdit{padding:8px 12px;}QLineEdit:focus,QTextEdit:focus,QDateEdit:focus,QDoubleSpinBox:focus,QComboBox:focus{border:1px solid #0051df;background-color:#f8f9fb;}QComboBox::drop-down,QDateEdit::drop-down,QDoubleSpinBox::up-button,QDoubleSpinBox::down-button{border:none;width:24px;}QComboBox::down-arrow,QDateEdit::down-arrow{image:url(:/icons/icons/down_arrow.svg);}QToolButton[class=&quot;primary&quot;]{background-color:#2f6bff;color:#fff;border:none;border-radius:4px;padding:8px 16px;font-family:&quot;Inter&quot;,&quot;Tajawal&quot;;font-size:12px;font-weight:500;}QToolButton[class=&quot;primary&quot;]:hover{background-color:#0051df;}QToolButton[class=&quot;primary&quot;]:focus{border:2px solid #00174d;}QToolButton[class=&quot;secondary&quot;]{background-color:#fff;color:#434655;border:1px solid #c3c5d8;border-radius:4px;padding:8px 16px;font-family:&quot;Inter&quot;,&quot;Tajawal&quot;;font-size:12px;font-weight:500;}QToolButton[class=&quot;secondary&quot;]:hover{background-color:#edeef0;color:#191c1e;}QTableWidget{background-color:#fff;border:1px solid #c3c5d8;border-radius:8px;color:#191c1e;font-family:&quot;Inter&quot;,&quot;Tajawal&quot;;font-size:13px;gridline-color:transparent;outline:none;}QHeaderView::section:horizontal{background-color:#f3f4f6;color:#434655;font-size:11px;font-weight:600;border:none;border-bottom:1px solid #c3c5d8;padding:8px 12px;}QTableWidget::item{padding:6px 12px;border-bottom:1px solid #edeef0;}QTableWidget::item:selected{background-color:#dbe1ff;color:#0051df;}</string>
