   <string notr="true">#Background{background-color:#f8f9fb;}QFrame[class=&quot;card&quot;]{background-color:#fff;border:1px solid #c3c5d8;border-radius:8px;}QLabel{color:#191c1e;background:transparent;border:none;font-family:&quot;Inter&quot;,&quot;Tajawal&quot;;font-size:13px;font-weight:500;}QLabel[class=&quot;field-label&quot;]{color:#434655;font-size:11px;font-weight:600;text-transform:uppercase;}QLineEdit,QDateEdit,QComboBox{background-color:#fff;border:1px solid #c3c5d8;border-radius:4px;padding:6px 12px;color:#191c1e;font-family:&quot;Inter&quot;,&quot;Tajawal&quot;;font-size:13px;font-weight:400;selection-background-color:#0051df;selection-color:#fff;}QLineEdit:focus,QDateEdit:focus,QComboBox:focus{border:1px solid #0051df;background-color:#f8f9fb;}QComboBox::drop-down,QDateEdit::drop-down{border:none;width:24px;}QComboBox::down-arrow,QDateEdit::down-arrow{image:url(:/icons/icons/down_arrow.svg);}QToolButton[class=&quot;primary&quot;]{background-color:#2f6bff;color:#fff;border:none;border-radius:4px;padding:8px 16px;font-family:&quot;Inter&quot;,&quot;Tajawal&quot;;font-size:12px;font-weight:500;}QToolButton[class=&quot;primary&quot;]:hover{background-color:#0051df;}QToolButton[class=&quot;primary&quot;]:focus{border:2px solid #00174d;}QToolButton[class=&quot;secondary&quot;]{background-color:transparent;color:#434655;border:none;border-radius:4px;padding:8px 12px;font-family:&quot;Inter&quot;,&quot;Tajawal&quot;;font-size:12px;font-weight:500;}QToolButton[class=&quot;secondary&quot;]:hover{background-color:#edeef0;color:#191c1e;}QToolButton[class=&quot;danger&quot;]{background-color:transparent;color:#434655;border:none;border-radius:4px;padding:8px 12px;font-family:&quot;Inter&quot;,&quot;Tajawal&quot;;font-size:12px;font-weight:500;}QToolButton[class=&quot;danger&quot;]:hover{background-color:#ffdad6;color:#ba1a1a;}QFrame[class=&quot;summary&quot;]{background-color:#fff;border:1px solid #c3c5d8;border-radius:4px;}QLabel[class=&quot;summary-title&quot;]{color:#434655;font-size:11px;font-weight:600;}QLabel[class=&quot;summary-value&quot;]{color:#191c1e;font-size:20px;font-weight:600;}QLabel#ValueMontantRegle{color:#0051df;}QLabel#ValueResteRegler{color:#ba1a1a;}</string>
