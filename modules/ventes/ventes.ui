            </size>
           </property>
           <property name="styleSheet">
            <string notr="true">/* ====================================================
   CARD 2: TOTAL TTC GLOBAL (Blue Accent Style)
==================================================== */
QFrame#FrameTTC {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
}

QLabel {
    color: #4b5563;             /* Muted gray-slate */
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}

QLabel#ValueTTC {
    color: #0051df;             /* Vibrant primary blue */
    font-size: 24px;
    font-weight: 700;
    background: transparent;
}</string>
