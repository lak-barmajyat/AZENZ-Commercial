            </size>
           </property>
           <property name="styleSheet">
            <string notr="true">/* ====================================================
   CARD 1: TOTAL HT GLOBAL (Neutral Style)
==================================================== */
QFrame#FrameHT {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
}

QLabel {
    color: #4b5563;             /* Muted gray-slate */
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}

QLabel#ValueHT {
    color: #111827;             /* Dark charcoal/black */
    font-size: 24px;
    font-weight: 700;
    background: transparent;
}</string>
           </property>
