           <property name="styleSheet">
            <string notr="true">/* ====================================================
   CARD 3: SOLDE GLOBAL (Danger/Alert Red Style)
==================================================== */
QFrame#FrameSolde {
    background-color: #ffffff;
    border: 1px solid #fee2e2;   /* Light pastel red border */
    border-radius: 8px;
}

QLabel {
    color: #b91c1c;             /* Clear dark red for warning header */
    font-size: 14px;
    font-weight: 500;
    background: transparent;
}

QLabel#ValueSolde {
    color: #7f1d1d;             /* Very deep burgundy red for visibility */
    font-size: 24px;
    font-weight: 700;
    background: transparent;
}</string>
