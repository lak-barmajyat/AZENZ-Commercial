/* QLineEdit has Icon */
QLineEdit[class="icon-lineedit"] {
    background-color: #ffffff;
    border: 2px solid #e0e0e0;
    border-radius: 6px;
    padding: 6px;
    color: #333333;
    
    selection-background-color: #0051df; 
    selection-color: #ffffff;
}

QLineEdit[class="icon-lineedit"]:hover {
    border: 2px solid #b3b3b3;
}

QLineEdit[class="icon-lineedit"]:focus {
    border: 2px solid #0051df;
    background-color: #fbfcff;
}

QLineEdit[class="icon-lineedit"]:disabled {
    background-color: #f5f5f5;
    color: #a0a0a0;
    border: 2px solid #e8e8e8;
}

QLineEdit[class="icon-lineedit"][readOnly="true"] {
    background-color: #fafafa;
    color: #666666;
    border: 2px dashed #cccccc;
}

/* QLineEdit */
QLineEdit {
    background-color: #ffffff;
    border: 2px solid #e0e0e0;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 14px;
    font-family: "Inyer", Arial, sans-serif;
    color: #333333;
    
    selection-background-color: #0051df; 
    selection-color: #ffffff;
}

QLineEdit:hover {
    border: 2px solid #b3b3b3;
}

QLineEdit:focus {
    border: 2px solid #0051df;
    background-color: #fbfcff;
}

QLineEdit:disabled {
    background-color: #f5f5f5;
    color: #a0a0a0;
    border: 2px solid #e8e8e8;
}

QLineEdit[readOnly="true"] {
    background-color: #fafafa;
    color: #666666;
    border: 2px dashed #cccccc;
}



/* Primary QPushButton Style */
QPushButton[class="primary"] {
    background-color: #0051df;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 12px;
    font-weight: 500;
    font-family: "Inter", "Tajawal";
}

QPushButton[class="primary"]:hover {
    background-color: rgba(0, 81, 223, 230); 
}

QPushButton[class="primary"]:pressed {
    background-color: rgba(0, 81, 223, 204);
}

QPushButton[class="primary"]:focus {
    border: 2px solid #00174d;
}


/* Outlined QPushButton Style */
QPushButton[class="outlined"] {
    background-color: #ffffff;
    color: #434655;
    border: 1px solid #c3c5d8;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 12px;
    font-weight: 500;
    font-family: "Inter", "Tajawal";
}    

QPushButton[class="outlined"]:hover {
    background-color: #f3f4f6;
}    

QPushButton[class="outlined"]:pressed {
    background-color: #edeef0;
}    

QPushButton[class="outlined"]:focus {
    border: 2px solid rgba(0, 81, 223, 51);
}    


/* CardToolButton */
QToolButton[class="card-button"] {
    background-color: #f8f9fa;
    border: 1px solid #eaebf0;
    border-radius: 12px;
}

QToolButton[class="card-button"]:hover {
    background-color: #f3f4f6;
    border: 1px solid #d1d5db;
}

QToolButton[class="card-button"]:pressed {
    background-color: #e5e7eb;
}

/* SidebarToolButton */
QToolButton[class="sidebar-button"] {
    background-color: transparent;
    color: #4b5563;
    border: none;
    border-left: 4px solid transparent; 
    padding: 12px 16px;
    spacing: 18px;
    
    text-align: left;
    font-size: 15px;
    font-weight: 500;
    font-family: "Inter";
}    

QToolButton[class="sidebar-button"]:checked {
    background-color: #d0e1fb;
    color: #0051df;
    border-left: 4px solid #0051df; 
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
}    

QToolButton[class="sidebar-button"]:unchecked:hover {
    background-color: #f3f4f6;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}    


QToolButton[class="icon-button"] {
    background-color: transparent;
    border: none;
    border-radius: 21px;
    padding: 8px;
}    

QToolButton[class="icon-button"]:hover {
    background-color: #f3f4f6;
}    

QToolButton[class="icon-button"]:pressed {
    background-color: #e5e7eb;
}    


/* LoginErrorLabel */
QLabel#LoginErrorLabel {
    background-color: #f8d7da;
    border: 1px solid #c9302c;
    border-radius: 10px;
    padding: 10px;
    padding-left: 15px;
	color: #721c24;	
	image: url(:/icons/resources/icons/warning.svg);
	image-position: left;
}    


/* ComboBox Box */
QComboBox {
    background-color: #ffffff;
    border: 2px solid #e0e0e0;
    border-radius: 6px;
    padding: 6px 12px;
    font-family: "Inter";
    color: #333333;
    min-width: 60px;
}

QComboBox:hover {
    border: 2px solid #b3b3b3;
}

QComboBox:focus {
    border: 2px solid #0051df;
    background-color: #fbfcff;
}

QComboBox::drop-down {
    /* subcontrol-origin: padding; */
    /* subcontrol-position: top right; */
    border: 6px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #eaebf0;
    border-radius: 0px;
    box-shadow: none;
    padding: 4px;
    
    selection-background-color: #0051df;
    selection-color: #ffffff;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: #4b5563;
    min-height: 24px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #f3f4f6;
    color: #0051df;
}

/* 4. The Arrow Icon itself */
QComboBox::down-arrow {
    image: url(:/icons/resources/icons/down_arrow.svg);
}


/* LoginFrame */
QFrame#LoginFrame {
    background-color: #ffffff;
    border: 1px solid #babcca; 
    border-radius: 12px; 
}    


/* Frame */
QFrame {
    background-color: #ffffff;
    border: none;
}    

QFrame[class="card"] {
    background-color: #ffffff;
    border: 1px solid #eaebf0; /* Soft gray border */
    border-radius: 12px;
}


/* QLabel */
QLabel {
    color: #000;
    border: none;
}

/* SeparatorLine */
QLabel#SeparatorLine {
    background-color: rgba(195, 197, 216, 0.5);
}

